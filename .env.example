# URL pública do site (OG/Twitter/links watch + app desktop). Ex.: https://seu-app.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Origens extras CORS para o cliente desktop (separadas por vírgula)
# DESKTOP_CORS_ORIGINS="http://localhost:5173"

# Neon / PostgreSQL
# Na Vercel: use a connection string "pooled" em DATABASE_URL.
# Opcional: DIRECT_URL com a string "direct/unpooled" para migrate deploy.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Segredo para assinar o cookie do anfitrião (obrigatório em produção).
HOST_COOKIE_SECRET="change-me-in-production"

# LiveKit Cloud
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="APIxxxxxxxx"
LIVEKIT_API_SECRET="your-secret"
