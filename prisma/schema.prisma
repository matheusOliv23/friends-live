// Nexus Stream — modelo de salas.
// SQLite agora (sem serviço externo). Para PostgreSQL:
// 1. provider = "postgresql"
// 2. DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
// 3. npx prisma migrate dev

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Room {
  id              String    @id
  status          String
  broadcasterId   String
  hostTokenHash   String
  /// Reserva para proteção futura do link do espectador (não usado nesta etapa).
  accessTokenHash String?
  /// Reserva para sessão de mídia (LiveKit/WebRTC) — ainda não populado.
  mediaSessionId  String?
  createdAt       DateTime  @default(now())
  liveAt          DateTime?
  endedAt         DateTime?

  @@index([status])
  @@index([broadcasterId])
}
