// Nexus Stream — modelo de salas (PostgreSQL / Neon).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Room {
  id              String    @id
  status          String
  broadcasterId   String
  hostTokenHash   String
  /// Reserva para proteção futura do link do espectador (não usado nesta etapa).
  accessTokenHash String?
  /// Reserva para sessão de mídia (LiveKit/WebRTC).
  mediaSessionId  String?
  createdAt       DateTime  @default(now())
  liveAt          DateTime?
  endedAt         DateTime?

  @@index([status])
  @@index([broadcasterId])
}
